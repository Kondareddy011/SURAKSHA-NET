# ============================================================================
# SURAKSHA-NET Environment Configuration Template
# ============================================================================
# Copy this file to '.env' and populate with your own keys if desired.
#
# NOTICE:
# The dashboard runs 100% locally with a full-featured rule-based demo assistant
# if no API key is set. Adding a Gemini API key is OPTIONAL.
# ============================================================================

# Optional: Google Gemini API Key for generative conversational AI
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Model Name (Default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

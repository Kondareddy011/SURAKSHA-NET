    {
      "type": "wokwi-led",
      "id": "led_alert",
      "top": 30,
      "left": -100,
      "attrs": { "color": "red", "label": "ALERT" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 70,
      "left": -100,
      "attrs": { "value": "220" }
    },
    {

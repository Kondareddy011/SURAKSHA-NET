{
  "version": 1,
  "author": "SURAKSHA-NET Engineering Team",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "chip-mpu6050",
      "id": "mpu1",
      "top": -140,
      "left": 160,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -140,
      "left": -120,
      "attrs": {}
    },
    {
      "type": "sensor-dht22",
      "id": "dht1",
      "top": 80,
      "left": 220,
      "attrs": {}
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_sos",
      "top": 160,

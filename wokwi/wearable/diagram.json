  "connections": [
    [ "esp:TX", "$serialMonitor", "RX", "" ],
    [ "esp:RX", "$serialMonitor", "TX", "" ],
    [ "oled1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "oled1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "oled1:SCL", "esp:22", "green", [ "v0" ] ],
    [ "oled1:SDA", "esp:21", "orange", [ "v0" ] ],
    [ "mpu1:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "mpu1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "mpu1:SCL", "esp:22", "green", [ "v0" ] ],
    [ "mpu1:SDA", "esp:21", "orange", [ "v0" ] ],
    [ "dht1:GND", "esp:GND.3", "black", [ "v0" ] ],
    [ "dht1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht1:SDA", "esp:15", "blue", [ "v0" ] ],
    [ "btn_sos:1.l", "esp:2", "green", [ "v0" ] ],
    [ "btn_sos:2.l", "esp:GND.1", "black", [ "v0" ] ],
    [ "led_alert:A", "esp:4", "red", [ "v0" ] ],
    [ "led_alert:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.2", "black", [ "v0" ] ],
    [ "buzz1:2", "esp:5", "purple", [ "v0" ] ],
    [ "buzz1:1", "esp:GND.3", "black", [ "v0" ] ]
